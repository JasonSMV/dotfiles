" ============================================================================
" GIT / VCS  (<leader>g)
" ============================================================================
" VCS operations popup
nnoremap <leader>gg :action ShowVcsOperationsPopup<CR>
" Git log / history
nnoremap <leader>gl :action Vcs.Show.Log<CR>
" Annotate (blame)
nnoremap <leader>ga :action Annotate<CR>
" Commit
nnoremap <leader>gc :action CheckinProject<CR>
" Branches
nnoremap <leader>gb :action Git.Branches<CR>

" ============================================================================
" WINDOWS / LAYOUT  (<leader>w, <leader>z)
" ============================================================================
" Splits
nnoremap <leader>ws :action SplitVertically<CR>
nnoremap <leader>wv :action SplitHorizontally<CR>
"nnoremap <leader>wd :action Unsplit<CR>
"nnoremap <leader>wD :action UnsplitAll<CR>

" Move focus between splits / tool windows (IDE side)
nnoremap <C-h> :action MoveFocusToLeft<CR>
nnoremap <C-j> :action MoveFocusToDown<CR>
nnoremap <C-k> :action MoveFocusToUp<CR>
nnoremap <C-l> :action MoveFocusToRight<CR>

" Hide all tool windows (similar to Shift+Esc)
" If this ID differs, find it via :actionlist Hide
nnoremap <leader>wh :action HideAllToolWindows<CR>

" Zen / distraction-free / fullscreen
nnoremap <leader>zz :action ToggleZenMode<CR>
nnoremap <leader>zD :action ToggleDistractionFreeMode<CR>
nnoremap <leader>zf :action ToggleFullScreen<CR>

nnoremap <leader>fbt :action ToggleBookmark<CR>

" TABS / BUFFERS
" ============================================================================
" Next / previous tab
nnoremap <Tab>   :action NextTab<CR>
nnoremap <S-Tab> :action PreviousTab<CR>
" Close current tab
nnoremap <leader>x :action CloseContent<CR>

" ============================================================================
" COMMENTS
" ============================================================================
nmap gc  <Plug>Commentary
vmap gc  <Plug>Commentary
nmap gcc <Plug>CommentaryLine

" ============================================================================
" VISUAL MODE IMPROVEMENTS
" ============================================================================
" Keep selection when indenting
vnoremap < <gv
vnoremap > >gv

" Jump between methods with [[ and ]]
nnoremap [[ :action MethodUp<CR>
nnoremap ]] :action MethodDown<CR>

" ============================================================================
" SAVE / QUIT
" ============================================================================
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

