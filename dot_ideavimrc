"" ============================================================================
" LAZYVIM-STYLE IDEA VIM CONFIG FOR RIDER 
" ============================================================================

" ------------------------------
" Base
" ------------------------------
let mapleader = " "

set number
set relativenumber
set showmode
set showcmd
set visualbell
set cursorline
set scrolloff=8
set sidescrolloff=5

" Search while tyhpeing
set incsearch

" highlight search results
set hlsearch
" remove search highlights when pressing Esc
nnoremap <Esc> :nohlsearch<CR>

" make the search case insensitive
set ignorecase
" Enable case-senstive search when an uppercase letter is present 
set smartcase

set clipboard^=unnamed,unnamedplus,ideaput
set clipboard+=unnamed,unnamedplus,ideaput

set history=2000
set ideajoin
set ideamarks
set ideastatusicon=gray

" cursor
set guicursor=n-v-c:hor100,i-ci-ve:ver30,r-cr:hor20,o:hor50

" ------------------------------
" Plugins (built into IdeaVim)
" ------------------------------
set surround
set commentary
set easymotion
set highlightedyank
set multiple-cursors
set argtextobj
set textobj-indent
set textobj-entire
set exchange
set ReplaceWithRegister
set notimeout
" see https://github.com/JetBrains/ideavim/wiki/NERDTree-support
set NERDTree

let g:NERDTreeMapActivateNode = 'l'
let g:NERDTreeMapJumpParent = 'h'
let g:NERDTreeMapCloseDir = 'x'

" File explorer 
" Toggle NERDTree (like <leader>e in LazyVim)
nnoremap <leader>e  :NERDTreeToggle<CR>
" Find current file in tree (like LazyVim's find in explorer)
nnoremap <leader>fe :NERDTreeFind<CR>
" Focus on NERDTree window
nnoremap <leader>E  :NERDTreeFocus<CR>
" ------------------------------
" Basic Vim QoL
" ------------------------------
inoremap jk <Esc>
nnoremap Y y$
nnoremap Q gq
nnoremap <Esc><Esc> :noh<CR>
" Change redo from cntrl + r to U (more accessible)
nnoremap U <C-r>
" Don't override the default register when pasting in visual mode
vnoremap p "_dP
" Don't override the default register when pasting in normal mode, need to prefix comand with \.
nnoremap \ "_
" Paste without without overiding the default register.
nnoremap p P
" jump between angle brackets
set matchpairs+=<:>

" Open config
nnoremap <leader>cc :e ~/.ideavimrc<CR>
" Source config
nnoremap <leader>cs :source ~/.ideavimrc<CR>:nohlsearch<CR>

" Consider camelCase and snake_case words when jumping between words

" move to the beginning of the next word
map w [w
" move to the end of the next word
map e ]w

map b [b
" move to the end of the previous word
map ge ]b

"" Choosing handlers in conflicting IDE/IdeaVim keymaps =======
sethandler <c-i> n-v-i:vim
sethandler <c-o> n-v-i:vim
sethandler <c-d> n-v-i:vim
sethandler <c-u> n-v-i:vim
sethandler <c-h> n-v-i:vim
sethandler <c-j> n-v-i:vim
sethandler <c-k> n-v-i:vim
sethandler <c-l> n-v-i:vim
sethandler <c-a-d> n-v-i:vim
sethandler <c-r> n-v-i:vim

map <leader>lg <Action>(LazyGit.Open)

" Git
nmap <leader>gg :action ActivateCommitToolWindow<cr>
nmap <leader>gb :action Annotate<cr>
nmap <leader>gl :action Vcs.Show.Log<cr>

" Enable the which-key popup
set which-key

" Disable timeout so the popup stays open
set notimeout
nmap <leader>wd :action CloseContent<cr>

" Remap control + r for copying text in the command line mode
cnoremap <C-v> <C-r>+

" Move half a page down, then center the cursor line on screen
nnoremap <C-d> <C-d>zz
" Move half a page up, then center the cursor line on screen
nnoremap <C-u> <C-u>zz

" Jump to the next search result, then center it and open folds if needed
nnoremap n nzzzv
" Jump to the previous search result, then center it and open folds if needed
nnoremap N Nzzzv

" Search forward for the word under the cursor, then center the result
nnoremap * *zzzv
" Search backward for the word under the cursor, then center the result
nnoremap # #zzzv

" Breakpoints && bookmarks {{{
nnoremap <Leader>bt     :action ToggleLineBreakpoint<CR>
nnoremap <Leader>bv     :action ViewBreakpoints<CR>

nnoremap <leader>BB     :action ToggleBookmark<cr>
nnoremap <leader>BV 	:action ShowBookmarks<cr>
nnoremap <leader>BT 	:action ToggleBookmarkWithMnemonic<cr>
"}}}

" Find && usage actions {{{
nnoremap <space>u   	:action FindUsages<cr>
nnoremap <space>U   	:action ShowUsages<cr>
nnoremap <space><a-f>  	:action FindUsagesInFile<cr>
nnoremap <space>h   	:action HighlightUsagesInFile<cr>
"}}}
" ============================================================================
" LSP-LIKE NAVIGATION
" ============================================================================
" Go to definition / type / implementation / references
nnoremap gd :action GotoDeclaration<CR>
nnoremap gD :action GotoTypeDeclaration<CR>
nnoremap gi :action GotoImplementation<CR>
nnoremap gr :action FindUsages<CR>
nnoremap gR :action ShowUsages<CR>
nnoremap K  :action QuickJavaDoc<CR>

" Jump between methods
nnoremap gj :action MethodDown<CR>
nnoremap gk :action MethodUp<CR>

" Jump history
nnoremap <C-o> :action Back<CR>
nnoremap <C-i> :action Forward<CR>

" Diagnostics
nnoremap [d :action GotoPreviousError<CR>
nnoremap ]d :action GotoNextError<CR>
nnoremap gl :action ShowErrorDescription<CR>

" ============================================================================
" FILES / PROJECT  (<leader>f, <leader>e)
" ============================================================================
" LazyVim-style: <leader>ff = find file, etc.

" Find file (quick open)
nnoremap <leader>ff :action SearchEverywhere<CR>
" Recent files
nnoremap <leader>fr :action RecentFiles<CR>

map <leader>fp :action ManageRecentProjects<cr>
map <leader>fc :action GotoClass<cr>
map <leader>fn :action GotoFile<cr>
map <leader>fa :action GotoAction<cr>
map <leader>fg :action FindInPath<cr>
map <leader>fl :action RecentLocations<cr>
map <leader>fm :action ShowBookmarks<cr>
map <leader>fs :action GotoSymbol<cr>
map <leader>fd :action Find<cr>
map <leader>fr :action Replace<cr>
map <leader>fR :action ReplaceInPath<cr>
map <leader>fx :action PasteMultiple<cr>
map <leader>fk :action ViewBreakpoints<cr>

" Solution Explorer / Project tool window
" (Equivalent to Alt+1 – opens/focuses Solution Explorer)
"nnoremap <leader>e  :action ActivateProjectToolWindow<CR>

" ============================================================================
" SEARCH  (<leader>s)
" ============================================================================
" Global search (like Telescope live_grep)
nnoremap <leader>sg :action FindInPath<CR>
" File structure (symbols in current file)
nnoremap <leader>ss :action FileStructurePopup<CR>
" Search everywhere
nnoremap <leader>sa :action SearchEverywhere<CR>
" Go to class
nnoremap <leader>sc :action GotoClass<CR>
" Go to symbol
nnoremap <leader>sm :action GotoSymbol<CR>

" ============================================================================
" CODE / REFACTOR  (<leader>c)
" ============================================================================
" Rename
nnoremap <leader>cr :action RenameElement<CR>
" Code actions / quick fixes
nnoremap <leader>ca :action ShowIntentionActions<CR>
" Format document
nnoremap <leader>cf :action ReformatCode<CR>
" Optimize usings
nnoremap <leader>co :action OptimizeImports<CR>

" Common refactors
nnoremap <leader>ce :action ExtractMethod<CR>
nnoremap <leader>cv :action IntroduceVariable<CR>
nnoremap <leader>cp :action IntroduceParameter<CR>
" TODO - Duplicated keybind. 
"nnoremap <leader>cc :action ChangeSignature<CR>

" Generate / implement / override members
nnoremap <leader>cg :action Generate<CR>
nnoremap <leader>ci :action ImplementMethods<CR>
nnoremap <leader>cO :action OverrideMethods<CR>

" ============================================================================
" BUILD / RUN / DEBUG  (<leader>b, <leader>r, <leader>d)
" ============================================================================
" Build solution
nnoremap <leader>b  :action BuildSolutionAction<CR>
nnoremap <leader>rb :action RebuildSolutionAction<CR>

" Run / Debug current configuration
nnoremap <leader>rr :action Run<CR>
nnoremap <leader>rd :action Debug<CR>
nnoremap <leader>rs :action Stop<CR>

" Debug controls
" nnoremap <leader>db :action ToggleLineBreakpoint<CR>
" nnoremap <leader>de :action ViewBreakpoints<CR>
nnoremap <leader>dc :action Resume<CR>
nnoremap <leader>di :action StepInto<CR>
nnoremap <leader>do :action StepOver<CR>
nnoremap <leader>dO :action StepOut<CR>
nnoremap <leader>dr :action Rerun<CR>

